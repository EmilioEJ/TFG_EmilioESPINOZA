% uti_tfm.sty — Estilo aproximado a la maquetación del PDF de referencia (UTI / Maestría Big Data)
% Compilación recomendada: XeLaTeX o LuaLaTeX (para Century Gothic real).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{uti_tfm}[2026/01/28 UTI TFM style]

% --- Motor y tipografías (Century Gothic) ---
\RequirePackage{iftex}
\ifPDFTeX
  % Fallback para pdfLaTeX: TeX Gyre Adventor (similar a Century Gothic)
  \RequirePackage{tgadventor}
  \renewcommand{\familydefault}{\sfdefault}
  \RequirePackage{newtxmath} % matemática legible en modo pdfLaTeX
\else
  \RequirePackage{fontspec}
  \defaultfontfeatures{Ligatures=TeX}
  \IfFontExistsTF{Century Gothic}{%
    \setmainfont{Century Gothic}
    \setsansfont{Century Gothic}
  }{%
    \setmainfont{TeX Gyre Adventor}
    \setsansfont{TeX Gyre Adventor}
  }
  % Matemática (no existe “Century Gothic Math”): usa una fuente matemática estándar
  \RequirePackage{unicode-math}
  \setmathfont{TeX Gyre Termes Math}
\fi

% --- Idioma ---
\RequirePackage[spanish,es-tabla]{babel}
\RequirePackage{etoolbox}
\RequirePackage{xparse}

% --- Página y espaciado (A4 y márgenes ~3 cm, como el PDF) ---
\RequirePackage{geometry}
\geometry{
  a4paper,
  left=3cm,right=3cm,
  top=3cm,bottom=3cm,
  headheight=14pt,headsep=0pt,
  footskip=1.2cm
}

\RequirePackage{setspace}
\RequirePackage{needspace}
\onehalfspacing

% Justificación y párrafos
\RequirePackage{ragged2e}
\AtBeginDocument{\justifying}
\setlength{\parindent}{1.25cm}
\setlength{\parskip}{0pt}

% --- Encabezados/pies: solo número centrado abajo ---
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyfoot[C]{\thepage}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}

% Asegurar que las páginas "plain" (apertura de capítulos, etc.) se vean igual
\fancypagestyle{plain}{%
  \fancyhf{}%
  \fancyfoot[C]{\thepage}%
  \renewcommand{\headrulewidth}{0pt}%
  \renewcommand{\footrulewidth}{0pt}%
}

% --- Capítulos y secciones (estilo CAPÍTULO I + título centrado en mayúsculas) ---
\RequirePackage{titlesec}

% Capítulos numerados en romanos (I, II, III…)
\renewcommand{\thechapter}{\Roman{chapter}}
\newcommand{\UTIChapterLabel}{CAPÍTULO }

\titleformat{\chapter}[display]
  {\centering\bfseries\Large}
  {\UTIChapterLabel \thechapter}
  {0.8\baselineskip}
  {\MakeUppercase}
\titlespacing*{\chapter}{0pt}{0pt}{1.8\baselineskip}

% Capítulos SIN numeración (p. ej., Bibliografía, Glosario) — sin “CAPÍTULO”
\titleformat{name=\chapter,numberless}[display]
  {\centering\bfseries\Large}
  {}
  {0.8\baselineskip}
  {\MakeUppercase}
\titlespacing*{name=\chapter,numberless}{0pt}{0pt}{1.8\baselineskip}

% En el PDF las secciones aparecen SIN numeración visible
\setcounter{secnumdepth}{0}

\titleformat{\section}
  {\bfseries\large}
  {}
  {0pt}
  {}
\titlespacing*{\section}{0pt}{1.2\baselineskip}{0.6\baselineskip}

\titleformat{\subsection}
  {\bfseries\normalsize}
  {}
  {0pt}
  {}
\titlespacing*{\subsection}{0pt}{1.0\baselineskip}{0.4\baselineskip}

% --- Tablas/Figuras/Imágenes (sin prefijo “No.”) ---
\RequirePackage[table]{xcolor}
\RequirePackage{array}
\RequirePackage{longtable}
\RequirePackage{pdflscape}
\RequirePackage{caption}
\RequirePackage{chngcntr}

% Numeración continua (no reinicia por capítulo), como en el PDF
\counterwithout{figure}{chapter}
\counterwithout{table}{chapter}
\counterwithout{equation}{chapter}

\renewcommand{\thefigure}{\arabic{figure}}
\renewcommand{\thetable}{\arabic{table}}
\renewcommand{\theequation}{\arabic{equation}}

% “Figura 1: …”
\captionsetup[figure]{%
  name=Figura,
  labelsep=colon,
  labelfont=bf,
  textfont=normalfont,
  justification=justified,
  singlelinecheck=false
}

% “Tabla 1: …”
\captionsetup[table]{%
  name=Tabla,
  labelsep=colon,
  labelfont=bf,
  textfont=normalfont,
  justification=justified,
  singlelinecheck=false
}

% Nuevo flotante: Imagen (para separar de Gráficos si lo deseas)
\RequirePackage{newfloat}
\DeclareFloatingEnvironment[
  fileext=loi,
  listname={Índice de Imágenes},
  name={Imagen}
]{imagen}
\counterwithout{imagen}{chapter}
\renewcommand{\theimagen}{\arabic{imagen}}
\captionsetup[imagen]{%
  name=Imagen,
  labelsep=colon,
  labelfont=bf,
  textfont=normalfont,
  justification=justified,
  singlelinecheck=false
}

% --- Índices adicionales (Ecuaciones y Anexos) ---
\RequirePackage{tocloft}

% Índice de ecuaciones (manual): usa \addeqtolist{Título} dentro de una ecuación para registrarla.
\newcommand{\listofecuacionesname}{Índice de Ecuaciones}
\newlistof{myeq}{loe}{\listofecuacionesname}
\newcommand{\listofecuaciones}{\listofmyeq}
\newcommand{\addeqtolist}[1]{%
  \addcontentsline{loe}{myeq}{\protect\numberline{\theequation}#1}%
}

% Índice de anexos: usa \Anexo{Título} para crear el capítulo de anexo y registrarlo en el índice de anexos.
\newcommand{\listofanexosname}{Índice de Anexos}
\newlistof{myanx}{loa}{\listofanexosname}
\newcommand{\listofanexos}{\listofmyanx}
\newcommand{\addanexotolist}[1]{%
  \addcontentsline{loa}{myanx}{#1}%
}

% --- Títulos de índices ---
\addto\captionsspanish{%
  \renewcommand{\contentsname}{Índice de Contenidos}%
  \renewcommand{\listtablename}{Índice de Tablas}%
  \renewcommand{\listfigurename}{Índice de Figuras}%
}
\providecommand{\listofimagenes}{\listof{imagen}{Índice de Imágenes}}

% --- Utilidades “Elaborado por:” / “Fuente:” como en el PDF ---
\newcommand{\elaboradopor}[1]{\par\noindent\textbf{Elaborado por:} #1\par}
\newcommand{\fuente}[1]{\par\noindent\textbf{Fuente:} #1\par}

\makeatletter

