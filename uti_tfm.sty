  \noindent\textbf{Correo Electrónico:} correo@ejemplo.com\par
  \noindent\textbf{Teléfono:} 0999999999\par
}

\newcommand{\UTIRepositorioAutorBloque}[2]{%
  \Needspace{10\baselineskip}%
  \UTIRepositorioAutorContenido{#1}{#2}%
}

\newcommand{\UTIRepositorioAutoresBloque}{%
  \UTIIfTwoAuthorsTF{%
    \Needspace{10\baselineskip}%
    \noindent
    \begin{minipage}[t]{0.47\textwidth}
      \raggedright
      \UTIRepositorioAutorContenido{\UTI@autorA}{\UTI@generoAutorA}%
    \end{minipage}\hfill
    \begin{minipage}[t]{0.47\textwidth}
      \raggedright
      \UTIRepositorioAutorContenido{\UTI@autorB}{\UTI@generoAutorB}%
    \end{minipage}%
  }{}%
  \UTIIfTwoAuthorsTF{}{%
    \UTIRepositorioAutorBloque{\UTI@autorA}{\UTI@generoAutorA}%
  }%
}

