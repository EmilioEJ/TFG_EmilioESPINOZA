}

\NewDocumentCommand{\UTIDatosTutor}{m m}{%
  \gdef\UTI@tutor{#1}%
  \gdef\UTI@generoTutor{#2}%
}

% --- Comandos convenientes para numeración preliminar y cuerpo ---
% Preliminares: romanos minúscula (i, ii, iii...) desde la primera página posterior a la portada
\newcommand{\UTIFrontMatter}{%
  \clearpage
  \pagenumbering{roman}% roman = minúscula por defecto
  \setcounter{page}{1}%
}

% Título de página preliminar (centrado en mayúsculas, página con numeración)
\newcommand{\UTIFrontTitle}[1]{%
  \clearpage
  \thispagestyle{plain}%
  \begin{center}\bfseries\MakeUppercase{#1}\end{center}%
  \vspace{1em}%
}

% Cuerpo: cambia a arábigos SIN reiniciar el contador (continúa desde el último romano)
\newcommand{\UTIMainMatter}{%
  \clearpage
  \renewcommand{\thepage}{\arabic{page}}%
  % Si hyperref está cargado, alinea los anclajes con el formato arábigo
  \@ifpackageloaded{hyperref}{%
    \@ifundefined{theHpage}{%
      \newcommand{\theHpage}{\arabic{page}}%
    }{%
      \renewcommand{\theHpage}{\arabic{page}}%
    }%
  }{}%
}

% Variante: reinicia a 1 en el cuerpo (por si alguna vez lo necesitas)
\newcommand{\UTIMainMatterReset}{%
  \clearpage
  \pagenumbering{arabic}%
  \setcounter{page}{1}%
}

% Anexos: cambia la etiqueta del capítulo a “ANEXO” y la numeración a letras (A, B, C...)
\newcommand{\UTIAppendixMatter}{%
  \clearpage
  \appendix
  \renewcommand{\thechapter}{\Alph{chapter}}%
  \renewcommand{\UTIChapterLabel}{ANEXO }%
}

% Crea un anexo como capítulo y lo registra en el Índice de Anexos
\newcommand{\Anexo}[1]{%
  \chapter{#1}%
  \addanexotolist{Anexo \thechapter: #1}%
}

% --- Carátula (portada) estilo UTI (aproximación) ---
\RequirePackage{graphicx}
\NewDocumentCommand{\UTIPortada}{m m m m m m m m m}{%
% #1 logo (ruta)  #2 Facultad  #3 Programa  #4 Tema/Título
% #5 Tipo de trabajo  #6 \UTIDatosAutores{...}{...}[...][...]
% #7 \UTIDatosTutor{...}{...}  #8 Ciudad–País  #9 Año
\gdef\UTI@logo{#1}%
\gdef\UTI@facultad{#2}%
\gdef\UTI@programa{#3}%
\gdef\UTI@titulo{#4}%
\gdef\UTI@tipotrabajo{#5}%
#6%
#7%
\gdef\UTI@ciudadpais{#8}%
\gdef\UTI@anio{#9}%
\begin{titlepage}
  \thispagestyle{empty}
  \begin{center}
    \vspace*{1.2cm}
    \includegraphics[width=0.18\textwidth]{Logos/#1}\par
    \vspace{1.2cm}
    {\bfseries\Large UNIVERSIDAD TECNOLÓGICA\par}
    {\bfseries\Large INDOAMÉRICA\par}
    \vspace{1.0cm}
    {\bfseries\Large #2\par}
    \vspace{0.8cm}
    {\bfseries\large #3\par}
    \vspace{1.1cm}
  \end{center}

  {\bfseries TEMA:\par}
  \vspace{0.2cm}\hrule\vspace{0.7cm}
  {\bfseries\large\MakeUppercase{#4}\par}
  \vspace{0.7cm}\hrule\vspace{0.7cm}

  {#5\par}

  \vfill
  \begin{center}
    \begin{minipage}{0.65\textwidth}
      \raggedright
      {\bfseries \UTIAutorEtiqueta\par}
      {\UTIAutoresPortada\par}
      \vspace{0.4cm}
      {\bfseries \UTITutorEtiqueta\par}
      {\UTITutorNombre\par}
    \end{minipage}
  \end{center}
  \vfill

  \begin{center}
    {\MakeUppercase{\UTICiudadPaisPortada}\par}
    \vspace{0.3cm}
    {#9\par}
  \end{center}
\end{titlepage}
\setcounter{page}{0}% evita que la portada cuente para la numeración
}

