\NewDocumentCommand{\UTISeleccionInvestigacion}{m m}{%
  \ifcsdef{UTI@linea@#1}{%
    \gdef\UTI@lineaInvestigacion{\csuse{UTI@linea@#1}}%
  }{%
    \PackageError{uti_tfm}{La línea de investigación #1 no existe}{Use un número entre 1 y 4, o 0 para dejarla pendiente.}%
  }%
  \ifcsdef{UTI@sublinea@#1@#2}{%
    \gdef\UTI@sublineaInvestigacion{\csuse{UTI@sublinea@#1@#2}}%
  }{%
    \PackageError{uti_tfm}{La sublínea #2 no existe para la línea #1}{Revise el catálogo definido en uti_tfm.sty.}%
  }%
}

