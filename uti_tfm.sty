% Página de Resumen/Abstract según la guía institucional.
% #1 idioma (spanish/english), #2 título, #3 texto,
% #4 etiqueta de palabras clave, #5 palabras clave.
\NewDocumentCommand{\UTIResumenPagina}{m m +m m +m}{%
  \clearpage
  \thispagestyle{plain}%
  \begingroup
  \UTIPortadaFuente
  \singlespacing
  \fontsize{12}{14.4}\selectfont
  \setlength{\parindent}{0pt}%

  % Textos de cabecera específicos de cada idioma.
  \def\UTI@resFacultad{\MakeUppercase{\UTIFacultad}}%
  \def\UTI@resPrograma{\MakeUppercase{\UTIPrograma}}%
  \def\UTI@resTemaEtiqueta{TEMA}%
  \def\UTI@resTema{\UTITituloProyectoMayusculas}%
  \def\UTI@resAutorEtiqueta{AUTOR(A)}%
  \def\UTI@resTutorEtiqueta{TUTOR(A)}%
  \ifstrequal{#1}{english}{%
    \def\UTI@resFacultad{FACULTY OF ENGINEERING}%
    \def\UTI@resPrograma{BACHELOR'S DEGREE IN INFORMATION TECHNOLOGY ENGINEERING}%
    \def\UTI@resTemaEtiqueta{TOPIC}%
    \def\UTI@resTema{\UTITituloProyectoInglesMayusculas}%
    \def\UTI@resAutorEtiqueta{AUTHOR}%
    \def\UTI@resTutorEtiqueta{ADVISOR}%
  }{}%

  \begin{center}
    \textbf{UNIVERSIDAD INDOAMÉRICA}\par
    \vspace{0.35cm}
    \textbf{\UTI@resFacultad}\par
    \vspace{0.35cm}
    \textbf{\UTI@resPrograma}\par
  \end{center}

  \vspace{\baselineskip}
  \noindent\textbf{\UTI@resTemaEtiqueta: \UTI@resTema}\par
  \vspace{0.45cm}

  \noindent\hspace*{0.42\textwidth}%
  \begin{minipage}{0.58\textwidth}
    \raggedright
    \textbf{\UTI@resAutorEtiqueta:} \UTIAutoresTexto\par
    \vspace{0.35cm}
    \textbf{\UTI@resTutorEtiqueta:} \UTITutorNombre\par
  \end{minipage}%

  \vspace{\baselineskip}
  \begin{center}
    \textbf{\MakeUppercase{#2}}\par
  \end{center}
  \vspace{0.35cm}

  \noindent\justifying #3\par

  \vfill
  \noindent\textbf{\MakeUppercase{#4}:} #5\par
  \endgroup
}

% Cuerpo: cambia a arábigos SIN reiniciar el contador (continúa desde el último romano)
\newcommand{\UTIMainMatter}{%
  \clearpage
  \renewcommand{\thepage}{\arabic{page}}%
  % Si hyperref está cargado, alinea los anclajes con el formato arábigo
  \@ifpackageloaded{hyperref}{%
    \@ifundefined{theHpage}{%
      \newcommand{\theHpage}{\arabic{page}}%
    }{%
      \renewcommand{\theHpage}{\arabic{page}}%
    }%
  }{}%
}

% Variante: reinicia a 1 en el cuerpo (por si alguna vez lo necesitas)
\newcommand{\UTIMainMatterReset}{%
  \clearpage
  \pagenumbering{arabic}%
  \setcounter{page}{1}%
}

% Anexos: cambia la etiqueta del capítulo a “ANEXO” y la numeración a letras (A, B, C...)
\newcommand{\UTIAppendixMatter}{%
  \clearpage
  \appendix
  \renewcommand{\thechapter}{\Alph{chapter}}%
  \renewcommand{\thesection}{\thechapter.\arabic{section}}%
  \renewcommand{\thesubsection}{\thesection.\arabic{subsection}}%
  \renewcommand{\UTIChapterLabel}{ANEXO }%
  % Desde este punto, las entradas numeradas del índice son anexos.
  \addtocontents{toc}{\protect\renewcommand{\protect\cftchappresnum}{ANEXO~}}%
}

% Crea un anexo como capítulo y lo registra en el Índice de Anexos
\newcommand{\Anexo}[1]{%
  \chapter{#1}%
  \addanexotolist{Anexo \thechapter: #1}%
}

