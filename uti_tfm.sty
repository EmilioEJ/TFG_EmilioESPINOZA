\newcommand{\UTIIfFemaleTF}[3]{%
  \edef\UTI@tmpGender{#1}%
  \ifdefstring{\UTI@tmpGender}{femenino}{#2}{%
    \ifdefstring{\UTI@tmpGender}{Femenino}{#2}{%
      \ifdefstring{\UTI@tmpGender}{F}{#2}{%
        \ifdefstring{\UTI@tmpGender}{f}{#2}{#3}%
      }%
    }%
  }%
}

\newcommand{\UTIIfTwoAuthorsTF}[2]{%
  \ifdefempty{\UTI@autorB}{#2}{#1}%
}

\newcommand{\UTIIfAllAuthorsFemaleTF}[2]{%
  \UTIIfTwoAuthorsTF{%
    \UTIIfFemaleTF{\UTI@generoAutorA}{%
      \UTIIfFemaleTF{\UTI@generoAutorB}{#1}{#2}%
    }{#2}%
  }{%
    \UTIIfFemaleTF{\UTI@generoAutorA}{#1}{#2}%
  }%
}

\newcommand{\UTIIfTutorFemaleTF}[2]{%
  \UTIIfFemaleTF{\UTI@generoTutor}{#1}{#2}%
}

